{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 build.py",
  "installCommand": "",
  "outputDirectory": "dist",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then exit 1; else exit 0; fi",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
